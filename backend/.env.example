# Google Gemini API Key (Required for the Agentic Loop)
GEMINI_API_KEY=

# MongoDB URI (Optional, if omitted or offline, the app falls back to JSON file storage)
MONGODB_URI=mongodb://localhost:27017

# Search Provider: 'duckduckgo' (default, free), 'google' (Google Places), or 'serper' (Serper Maps)
SEARCH_PROVIDER=duckduckgo

# API Keys for Google Places or Serper (Optional, only needed if SEARCH_PROVIDER is set to 'google' or 'serper')
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
